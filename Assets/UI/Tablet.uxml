<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Scroller.uss?fileID=7433441132597879392&amp;guid=254c00cc047f5714cb055ca2323b2b30&amp;type=3#Scroller" />
    <ui:VisualElement style="flex-grow: 1; width: 400px; height: 600px; flex-direction: row;">
        <ui:VisualElement style="flex-grow: 0; width: 30px; background-color: rgb(137, 137, 137);">
            <ui:VisualElement style="flex-grow: 0; flex-direction: row;">
                <ui:Button icon-image="project://database/Assets/Resources/Icons/Warning.png?fileID=2800000&amp;guid=d6d62d842954bb34e836a1e2713eb4b1&amp;type=3#Warning" style="margin-top: 20px; margin-right: 0; margin-bottom: 0; margin-left: 5px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; height: 20px; width: 20px; background-color: rgba(188, 188, 188, 0); border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;" />
                <ui:Label text="0" style="margin-top: 20px; margin-right: 0; margin-bottom: 0; margin-left: -5px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; font-size: 8px;" />
            </ui:VisualElement>
            <ui:VisualElement style="flex-grow: 0; flex-direction: row;">
                <ui:Button icon-image="project://database/Assets/Resources/Icons/Info.png?fileID=2800000&amp;guid=9f56e62b0a401e44ab7b278d92adca18&amp;type=3#Info" style="margin-top: 5px; margin-right: 0; margin-bottom: 0; margin-left: 5px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; height: 20px; width: 20px; background-color: rgba(188, 188, 188, 0); border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;" />
                <ui:Label text="0" style="margin-top: 5px; margin-right: 0; margin-bottom: 0; margin-left: -5px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; font-size: 8px;" />
            </ui:VisualElement>
            <ui:VisualElement style="flex-grow: 0; flex-direction: row;">
                <ui:Button icon-image="project://database/Assets/Resources/Icons/Error.png?fileID=2800000&amp;guid=7ee824756dab1c640a78653ed5da3095&amp;type=3#Error" style="margin-top: 5px; margin-right: 0; margin-bottom: 0; margin-left: 5px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; height: 20px; width: 20px; background-color: rgba(188, 188, 188, 0); border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;" />
                <ui:Label text="0" style="margin-top: 20px; margin-right: 0; margin-bottom: 0; margin-left: -5px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; font-size: 8px;" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement style="flex-grow: 1; height: auto;">
            <ui:VisualElement style="flex-grow: 0; height: 20px; background-color: rgb(137, 137, 137);" />
            <ui:VisualElement style="flex-grow: 1; flex-direction: row;">
                <ui:ScrollView vertical-page-size="-1" mode="Horizontal" style="flex-direction: row; height: 100%; width: 100%; flex-grow: 1;">
                    <ui:VisualElement style="flex-grow: 1; flex-direction: row; height: 100%; min-height: auto;">
                        <ui:VisualElement style="flex-grow: 0; height: 100%; width: 25px; background-color: rgb(255, 255, 255); flex-direction: row-reverse; align-self: auto; align-items: stretch; justify-content: flex-start; background-size: 100% 100%;">
                            <ui:TextField multiline="true" vertical-scroller-visibility="Hidden" is-delayed="false" name="LineNumber" focusable="true" style="flex-shrink: 1; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; align-self: auto; align-items: stretch; align-content: flex-start; justify-content: flex-start; height: 100%; flex-grow: 1; font-size: 12px; -unity-text-align: upper-right;" />
                        </ui:VisualElement>
                        <ui:VisualElement style="flex-grow: 1; width: 100%; height: 100%; background-color: rgb(197, 197, 197); flex-direction: row; align-self: auto; min-width: auto; min-height: auto;">
                            <ui:TextField multiline="true" vertical-scroller-visibility="Hidden" is-delayed="false" style="flex-grow: 1; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; font-size: 12px;" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:ScrollView>
            </ui:VisualElement>
            <ui:VisualElement style="flex-grow: 0; height: 50px; background-color: rgb(137, 137, 137); flex-direction: row; flex-wrap: wrap;">
                <ui:Button text="Редактировать" style="font-size: 10px; width: auto; height: 20px; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; padding-top: 2px; padding-right: 2px; padding-bottom: 2px; padding-left: 2px; margin-top: 2px; margin-right: 2px; margin-bottom: 2px; margin-left: 2px; border-top-left-radius: 3px; border-top-right-radius: 3px; border-bottom-right-radius: 3px; border-bottom-left-radius: 3px; background-color: rgb(217, 217, 217);" />
                <ui:Button text="Точка" style="font-size: 10px; width: auto; height: 20px; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; padding-top: 2px; padding-right: 2px; padding-bottom: 2px; padding-left: 2px; margin-top: 2px; margin-right: 2px; margin-bottom: 2px; margin-left: 2px; border-top-left-radius: 3px; border-top-right-radius: 3px; border-bottom-right-radius: 3px; border-bottom-left-radius: 3px; background-color: rgb(217, 217, 217);" />
                <ui:Button text="Условие" style="font-size: 10px; width: auto; height: 20px; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; padding-top: 2px; padding-right: 2px; padding-bottom: 2px; padding-left: 2px; margin-top: 2px; margin-right: 2px; margin-bottom: 2px; margin-left: 2px; border-top-left-radius: 3px; border-top-right-radius: 3px; border-bottom-right-radius: 3px; border-bottom-left-radius: 3px; background-color: rgb(217, 217, 217);" />
                <ui:Button text="Задержка" style="font-size: 10px; width: auto; height: 20px; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; padding-top: 2px; padding-right: 2px; padding-bottom: 2px; padding-left: 2px; margin-top: 2px; margin-right: 2px; margin-bottom: 2px; margin-left: 2px; border-top-left-radius: 3px; border-top-right-radius: 3px; border-bottom-right-radius: 3px; border-bottom-left-radius: 3px; background-color: rgb(217, 217, 217);" />
                <ui:Button text="Цикл" style="font-size: 10px; width: auto; height: 20px; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; padding-top: 2px; padding-right: 2px; padding-bottom: 2px; padding-left: 2px; margin-top: 2px; margin-right: 100px; margin-bottom: 2px; margin-left: 2px; border-top-left-radius: 3px; border-top-right-radius: 3px; border-bottom-right-radius: 3px; border-bottom-left-radius: 3px; background-color: rgb(217, 217, 217);" />
                <ui:Button text="Изменить выход" style="font-size: 10px; width: auto; height: 20px; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; padding-top: 2px; padding-right: 2px; padding-bottom: 2px; padding-left: 2px; margin-top: 2px; margin-right: 2px; margin-bottom: 2px; margin-left: 2px; border-top-left-radius: 3px; border-top-right-radius: 3px; border-bottom-right-radius: 3px; border-bottom-left-radius: 3px; background-color: rgb(217, 217, 217);" />
                <ui:Button text="Переменная" style="font-size: 10px; width: auto; height: 20px; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; padding-top: 2px; padding-right: 2px; padding-bottom: 2px; padding-left: 2px; margin-top: 2px; margin-right: 2px; margin-bottom: 2px; margin-left: 2px; border-top-left-radius: 3px; border-top-right-radius: 3px; border-bottom-right-radius: 3px; border-bottom-left-radius: 3px; background-color: rgb(217, 217, 217);" />
                <ui:Button text="Подпрограмма" style="font-size: 10px; width: auto; height: 20px; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; padding-top: 2px; padding-right: 2px; padding-bottom: 2px; padding-left: 2px; margin-top: 2px; margin-right: 2px; margin-bottom: 2px; margin-left: 2px; border-top-left-radius: 3px; border-top-right-radius: 3px; border-bottom-right-radius: 3px; border-bottom-left-radius: 3px; background-color: rgb(217, 217, 217);" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
