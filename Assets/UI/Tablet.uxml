                <ui:Label text="0" style="margin-top: 5px; margin-right: 0; margin-bottom: 0; margin-left: -5px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; font-size: 8px;" />
            </ui:VisualElement>
            <ui:VisualElement style="flex-grow: 0; flex-direction: row;">
                <ui:Button icon-image="project://database/Assets/Resources/Icons/Error.png?fileID=2800000&amp;guid=7ee824756dab1c640a78653ed5da3095&amp;type=3#Error" name="error-button" style="margin-top: 5px; margin-right: 0; margin-bottom: 0; margin-left: 5px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; height: 20px; width: 20px; background-color: rgba(188, 188, 188, 0); border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;" />
                <ui:Label text="0" style="margin-top: 5px; margin-right: 0; margin-bottom: 0; margin-left: -5px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; font-size: 8px;" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement style="flex-grow: 1; height: auto;">
            <ui:VisualElement style="flex-grow: 0; height: 20px; background-color: rgb(137, 137, 137); flex-direction: row;">
                <ui:VisualElement style="flex-grow: 0; flex-shrink: 0;">
                    <ui:DropdownField label="Редактор" name="FileDropdown" style="height: 20px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; -unity-text-align: middle-left; font-size: 10px;" />
                </ui:VisualElement>
                <ui:VisualElement style="flex-grow: 1; flex-direction: row;">
                    <ui:Button icon-image="project://database/Assets/Resources/Icons/icons8-%D0%BE%D1%82%D0%BA%D1%80%D1%8B%D1%82%D1%8C-%D0%BF%D0%B0%D0%BF%D0%BA%D1%83-480.png?fileID=2800000&amp;guid=8af2cd929e47e8a41af3d06911fbe032&amp;type=3#icons8-открыть-папку-480" name="open-file-button" style="align-items: stretch; flex-shrink: 0; flex-grow: 0; height: 20px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; width: 20px; background-color: rgba(188, 188, 188, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;" />
                    <ui:Button icon-image="project://database/Assets/Resources/Icons/Save.png?fileID=2800000&amp;guid=7eac02fa00f9fd04bbdd93843ded642a&amp;type=3#Save" name="save-file-button" style="align-items: stretch; flex-shrink: 0; flex-grow: 0; height: 20px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; width: 20px; background-color: rgba(188, 188, 188, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;" />
                    <ui:Button icon-image="project://database/Assets/Resources/Icons/SaveAs.png?fileID=2800000&amp;guid=bde3b008cba373a48bde1cb9675d481c&amp;type=3#SaveAs" name="save-as-button" style="align-items: stretch; flex-shrink: 0; flex-grow: 0; height: 20px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; width: 20px; background-color: rgba(188, 188, 188, 0); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0);" />
                </ui:VisualElement>
                <ui:Button text="X" name="close-tablet-button" focusable="false" style="border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; font-size: 10px; margin-top: 1px; margin-right: 1px; margin-bottom: 1px; margin-left: 1px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; height: 18px; width: 18px; background-color: rgb(255, 77, 77); border-top-left-radius: 3px; border-top-right-radius: 3px; border-bottom-right-radius: 3px; border-bottom-left-radius: 3px; border-left-color: rgb(255, 77, 77); border-right-color: rgb(255, 77, 77); border-top-color: rgb(255, 77, 77); border-bottom-color: rgb(255, 77, 77); color: rgb(255, 255, 255);" />
            </ui:VisualElement>
            <ui:VisualElement style="flex-grow: 1; flex-direction: row;">
                <ui:ScrollView vertical-page-size="-1" mode="Horizontal" style="flex-direction: row; height: 100%; width: 100%; flex-grow: 1;">
                    <ui:VisualElement style="flex-grow: 1; flex-direction: row; height: 100%; min-height: auto;">
                        <ui:VisualElement style="flex-grow: 0; height: 100%; width: 25px; background-color: rgb(255, 255, 255); flex-direction: row-reverse; align-self: auto; align-items: stretch; justify-content: flex-start; background-size: 100% 100%;">
                            <ui:TextField multiline="true" vertical-scroller-visibility="Hidden" is-delayed="false" name="LineNumber" focusable="false" style="flex-shrink: 1; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; align-self: auto; align-items: stretch; align-content: flex-start; justify-content: flex-start; height: 100%; flex-grow: 1; font-size: 12px; -unity-text-align: upper-right;" />
                        </ui:VisualElement>
                        <ui:VisualElement style="flex-grow: 1; width: 100%; height: 100%; background-color: rgb(197, 197, 197); flex-direction: row; align-self: auto; min-width: auto; min-height: auto;">
                            <ui:TextField multiline="true" vertical-scroller-visibility="Hidden" is-delayed="false" name="TXT" select-all-on-focus="false" select-all-on-mouse-up="false" hide-mobile-input="false" style="flex-grow: 1; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 0; font-size: 12px; white-space: nowrap;" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:ScrollView>
            </ui:VisualElement>
            <ui:VisualElement style="flex-grow: 0; height: 60px; background-color: rgb(137, 137, 137); flex-direction: row; flex-wrap: wrap;">
                <ui:VisualElement style="flex-grow: 1; flex-direction: row; margin-top: 5px;">
                    <ui:Button text="Точка PTP" name="ptp-point-button" style="font-size: 10px; width: auto; height: 20px; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; padding-top: 2px; padding-right: 2px; padding-bottom: 2px; padding-left: 2px; margin-top: 2px; margin-right: 2px; margin-bottom: 2px; margin-left: 2px; border-top-left-radius: 3px; border-top-right-radius: 3px; border-bottom-right-radius: 3px; border-bottom-left-radius: 3px; background-color: rgb(217, 217, 217);" />
