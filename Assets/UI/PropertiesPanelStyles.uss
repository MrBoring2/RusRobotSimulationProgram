#properties-panel-content-container {
    padding: 1px;
}

/* === Верхнее меню с кнопкой закрытия === */
#menu {
    margin-bottom: 15px;

}

#close-properties-button {
    width: 20px;
    height: 20px;
    background-color: #ff4d4d;
    color: white;
    border-radius: 3px;
    border-width: 0;
    padding: 0;
    margin: 0;
}

#close-properties-button:hover {
    background-color: #ff1a1a;
}

#base-properties-container {
}

/* === Строки свойств === */
.base-property,
.base-bool-property, 
#position-property-container,
#rotation-property-container,
#scale-property-container {
    margin-bottom: 2px;
}

.base-bool-property {
    flex-direction: row;
}

/* === Label свойств === */
.base-property > Label,
.base-bool-property > Label,
#position-property-container > Label,
#rotation-property-container > Label,
#scale-property-container > Label {
    color: #e0e0e0;
    font-size: 10px;
    margin-right: 10px;
}

.base-property > VisualElement,
.base-bool-property > VisualElement,
#position-input-container,
#rotation-input-container,
#scale-input-container {
    
}


#position-input-container,
#rotation-input-container,
#scale-input-container {
    flex-direction: row;       
    justify-content: flex-end;
    align-items: center;       
}

/* === Поля ввода XYZ === */
#position-input-container > FloatField,
#rotation-input-container > FloatField,
#scale-input-container > FloatField {
           
    width: 60px;              
    height: 20px;             
    padding: 0;                       
    box-sizing: border-box;  
    background-color: #9fbaff;


}


TextField,
FloatField,
.input-field,
.unity-text-input,
.unity-base-field__input,
.unity-base-text-field__input {
    width: auto;              

    height: 20px;
    padding: 0;
    margin: 0;
    box-sizing: border-box;
    border: 1px solid #555;
    border-radius: 3px;
}

TextField:focus,
FloatField:focus,
.input-field:focus {
    border-color: #1e90ff;
    outline: none;
}

#custom-properties-container {
    margin-top: 5px;
}

.unity-text-element {
    font-size: 10px;
    height: 20px;
    
}

.unity-base-field__label {
    min-width: 10px;
    margin: 0;
  
}

.unity-base-field__label:hover {
    color: #1e90ff;
}


.custom-slider .unity-base-slider__drag-container {
    background-color: rgb(60, 60, 60);
    border-radius: 4px;
}

.custom-slider .unity-base-slider__tracker {
    background-color: rgb(40, 40, 40);
    height: 4px;
        margin-top: -1px;
    border-radius: 2px;
}

.custom-slider .unity-base-slider__dragger {
    width: 8px;
    height: 20px;
    margin-top: -9px;
    background-color: rgb(60, 60, 60);
   border-radius: 2px;
    border-width: 1px;
    border-color: rgb(100, 100, 100);
}

.custom-slider .unity-base-slider__dragger:hover {
   background-color: rgb(200, 200, 200);
    border-color: rgb(120, 120, 120);
}

.custom-slider .unity-base-slider__dragger:focus {
    background-color: rgb(180, 180, 255);
}
.custom-dropdown {
     margin-left: 0px;
    margin-right: 0px;
}
.custom-dropdown .unity-base-popup-field__input {
    background-color: rgb(30, 40, 60);
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-color: rgb(60, 80, 120);
    border-bottom-color: rgb(60, 80, 120);
    border-left-color: rgb(60, 80, 120);
    border-right-color: rgb(60, 80, 120);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
   
    height: 24px;
    flex-direction: row;
    align-items: center;
    padding-left: 8px;
    padding-right: 4px;
}

.custom-dropdown:hover .unity-base-popup-field__input {
    border-top-color: rgb(80, 100, 160);
    border-bottom-color: rgb(80, 100, 160);
    border-left-color: rgb(80, 100, 160);
    border-right-color: rgb(80, 100, 160);
}

.custom-dropdown .unity-base-popup-field__text {
    color: rgb(255, 255, 255);
    font-size: 13px;
    -unity-text-align: middle-left;
    flex-grow: 1;
}

.custom-dropdown .unity-base-popup-field__arrow {
    -unity-background-image-tint-color:  rgb(180, 200, 240);
    -unity-text-align: middle-center;
}
