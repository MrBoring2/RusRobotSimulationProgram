#types-list .unity-base-popup-field__input, #variable-name .unity-base-popup-field__input, #operations-list .unity-base-popup-field__input {
    background-color: rgb(30, 40, 60);
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-color: rgb(60, 80, 120);
    border-bottom-color: rgb(60, 80, 120);
    border-left-color: rgb(60, 80, 120);
    border-right-color: rgb(60, 80, 120);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    color: white;
    margin-left: 0;
    margin-right: 0;
    flex-direction: row;
    align-items: center;
    padding-left: 8px;
    padding-right: 4px;
    height: 20px;
}

#types-list:hover .unity-base-popup-field__input, #variable-name:hover .unity-base-popup-field__input, #operations-list:hover .unity-base-popup-field__input {
    border-top-color: rgb(80, 100, 160);
    border-bottom-color: rgb(80, 100, 160);
    border-left-color: rgb(80, 100, 160);
    border-right-color: rgb(80, 100, 160);
}

#types-list .unity-base-popup-field__input, #variable-name .unity-base-popup-field__text, #operations-list .unity-base-popup-field__text {
    color: rgb(255, 255, 255);
    font-size: 13px;
    -unity-text-align: middle-left;
    flex-grow: 1;
}

#types-list .unity-base-popup-field__arrow, #variable-name .unity-base-popup-field__arrow, #operations-list .unity-base-popup-field__arrow {
    -unity-background-image-tint-color:  rgb(180, 200, 240);
    -unity-text-align: middle-center;
}
