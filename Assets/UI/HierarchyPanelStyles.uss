/* HierarchyPanelStyles.uss */



/* Основной контейнер панели */
.hierarchy-container {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    min-width: 0;
}

/* ScrollView - должен заполнять весь контейнер */
.hierarchy-scrollview {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
}

/* Контейнер контента ScrollView - должен расширяться */
.unity-scroll-view__content-container {
    min-width: 240px;
    width: auto;
    flex-shrink: 0;
    padding-bottom: 12px !important;
}

/* Основной Foldout */
#main-item {
    min-width: 240px;
    width: auto; /* Может быть шире */
    flex-shrink: 0;
}

/* Элементы иерархии - должны быть шире чем панель для появления прокрутки */
.hierarchy-item-robot,
.hierarchy-item-program,
.hierarchy-item-command {
    min-width: 300px; /* Сделай ШИРЕ чем 240px для теста! */
    width: auto;
    flex-shrink: 0;
    white-space: nowrap;
}


.hierarchy-item-container-base.selected {
    background-color: #2a6cff;
    border-radius: 3px;
}

    .custom-foldout .header.selected {
    background-color: #2a6cff !important;
    border-radius: 3px;
}

    #menu {
    padding-bottom: 20px;
        padding-left: 10px;
        padding-top: 10px;
}

#close-hierarhy-button {
    width: 20px;
    height: 20px;
    background-color: #ff4d4d;
    color: white;
    border-radius: 3px;
    border-width: 0;
    padding: 0;
    margin: 0;
      font-size: 10px;
}

#close-hierarhy-button:hover {
    background-color: #ff1a1a;
}
.drop-target-above {
    border-top-width: 3px;
    border-top-color: #4CAF50;
    margin-top: 2px !important;
    padding-top: 2px !important;
}

.drop-target-below {
    border-bottom-width: 3px;
    border-bottom-color: #4CAF50;
    margin-bottom: 2px !important;
    padding-bottom: 2px !important;
}

.drop-target-inside {
    background-color: rgba(76, 175, 80, 0.3) !important;
    border: 2px solid #4CAF50 !important;
    border-radius: 4px;
    padding: 2px 4px !important;
}

.drag-preview {
    position: absolute;
    background-color: rgba(66, 135, 245, 0.9);
    border: 2px solid #4287f5;
    border-radius: 4px;
    pointer-events: none;
    z-index: 9999;
    opacity: 0.9;
    box-shadow: 2px 2px 10px rgba(0,0,0,0.3);
    padding: 2px 8px;
    max-width: 200px;
}

.drag-preview > Label {
    color: white;
    font-size: 12px;
    font-weight: normal;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

    .move-buttons-container {
    position: absolute;
    right: 5px;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    gap: 2px;
    opacity: 0;
    transition: opacity 0.2s;
}

.hierarchy-item:hover .move-buttons-container {
    opacity: 1;
}

.move-up-button,
.move-down-button {
    width: 16px;
    height: 16px;
    min-width: 16px;
    min-height: 16px;
    padding: 0;
    margin: 0;
    border: 1px solid #555;
    background-color: #333;
    color: white;
    font-size: 10px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
}

.move-up-button:hover,
.move-down-button:hover {
    background-color: #555;
}

.move-up-button:disabled,
.move-down-button:disabled {
    opacity: 0.3;
    cursor: not-allowed;
}

    /* При наведении показываем кнопки */
.hierarchy-item-container:hover .move-buttons {
    opacity: 1;
}

.hierarchy-item-container {
    position: relative;
}

/* Контейнер для кнопок */
.move-buttons {
    position: absolute;
    right: 5px;
    display: flex;
    gap: 2px;
    opacity: 0;
    transition: opacity 0.2s ease;
}

/* Стили кнопок */
.move-button {
    width: 16px;
    height: 16px;
    min-width: 16px;
    min-height: 16px;
    padding: 0;
    margin: 0;
    border: 1px solid #555;
    background-color: #333;
    color: white;
    font-size: 10px;
    cursor: pointer;
    border-radius: 2px;
    display: flex;
    align-items: center;
    justify-content: center;
}

/* Эффект наведения на кнопки */
.move-button:hover {
    background-color: #555;
}

/* Отключенные кнопки */
.move-button:disabled {
    opacity: 0.3;
    cursor: not-allowed;
    background-color: #222;
}

/* Конкретные кнопки */
.move-up-button {
    content: '←';
}

.move-down-button {
    content: '→';
}

/* Для CustomFoldout (роботы и программы) */
.hierarchy-foldout .move-buttons {
    right: 25px; /* Чтобы не перекрывалась кнопка раскрытия */
}

/* Текст элемента */
.hierarchy-label {
    flex-grow: 1;
    color: rgb(255, 255, 255);
    font-size: 12px;
    margin-top: 2px;
    margin-bottom: 2px;
}
/* Базовый стиль для всех PLC блоков - убираем скругление везде */
.plc-condition-block,
.plc-if-block,
.plc-elif-block,
.plc-else-block,
.plc-robot-block,
.plc-robots-block,
.plc-init-block,
.plc-logic-block {
    margin-bottom: 4px;
    overflow: hidden;
    border-left-width: 0;
}

/* Раскрытые блоки - добавляем левый бордер */
.plc-condition-block.expanded,
.plc-if-block.expanded,
.plc-elif-block.expanded,
.plc-else-block.expanded,
.plc-robot-block.expanded,
.plc-robots-block.expanded,
.plc-init-block.expanded,
.plc-logic-block.expanded {
    border-left-width: 3px;
}

/* Цвета бордеров */
.plc-condition-block.expanded { border-left-color: #8ac0e0; }
.plc-if-block.expanded { border-left-color: #80e0a0; }
.plc-elif-block.expanded { border-left-color: #e0c080; }
.plc-else-block.expanded { border-left-color: #e08080; }
.plc-robot-block.expanded { border-left-color: #80e0c0; }
.plc-robots-block.expanded { border-left-color: #6ac0a0; }
.plc-init-block.expanded { border-left-color: #a0e080; }
.plc-logic-block.expanded { border-left-color: #c080e0; }

/* Заголовки - без скругления */
.plc-condition-block > .header {
    background-color: #5a7a9a;
    border-radius: 0;
    margin-bottom: 0;
}
.plc-if-block > .header {
    background-color: #4a8a6a;
    border-radius: 0;
    margin-bottom: 0;
}
.plc-elif-block > .header {
    background-color: #9a8a4a;
    border-radius: 0;
    margin-bottom: 0;
}
.plc-else-block > .header {
    background-color: #9a5a5a;
    border-radius: 0;
    margin-bottom: 0;
}
.plc-robot-block > .header {
    background-color: #5a7a7a;
    border-radius: 0;
    margin-bottom: 0;
}
.plc-robots-block > .header {
    background-color: #4a6a6a;
    border-radius: 0;
    margin-bottom: 0;
}
.plc-init-block > .header {
    background-color: #6a8a4a;
    border-radius: 0;
    margin-bottom: 0;
}
.plc-logic-block > .header {
    background-color: #8a6aaa;
    border-radius: 0;
    margin-bottom: 0;
}

/* Контент */
.plc-condition-block > .content {
    background-color: #4a6a8a;
}
.plc-if-block > .content {
    background-color: #3a7a5a;
}
.plc-elif-block > .content {
    background-color: #8a7a3a;
}
.plc-else-block > .content {
    background-color: #8a4a4a;
}
.plc-robot-block > .content {
    background-color: #4a6a6a;
}
.plc-robots-block > .content {
    background-color: #4a6a6a;
}
.plc-init-block > .content {
    background-color: #5a7a3a;
}
.plc-logic-block > .content {
    background-color: #7a5a9a;
}

/* Общие стили для контента */
.plc-condition-block > .content,
.plc-if-block > .content,
.plc-elif-block > .content,
.plc-else-block > .content,
.plc-robot-block > .content,
.plc-robots-block > .content,
.plc-init-block > .content,
.plc-logic-block > .content {
    margin-top: 0;
    padding-top: 2px;
    padding-bottom: 2px;
    padding-left: 12px;
}

/* Текст заголовков */
.unity-label {
    color: #ffffff;
}

/* Команды */
.plc-var, .plc-command {
    background-color: rgba(100, 120, 140, 0.8);
    border-radius: 0;
    margin-top: 2px;
    margin-bottom: 2px;
    border-left-color: #a0d0f0;
    border-left-width: 2px;
}

.plc-command .label-hierarchy {
    color: #ffffff;
}

.hierarchy-item-program.drop-target-inside {
    border-left-color: #4CAF50;
    border-left-width: 2px;
    background-color: rgba(76, 175, 80, 0.2);
}

.hierarchy-item-command.drop-target-above {
    border-top-color: #4CAF50;
    border-top-width: 2px;
}

.hierarchy-item-command.drop-target-below {
    border-bottom-color: #4CAF50;
    border-bottom-width: 2px;
}

.hierarchy-item-command.drop-target-inside {
    border-left-color: #4CAF50;
    border-left-width: 2px;
    background-color: rgba(76, 175, 80, 0.2);
}