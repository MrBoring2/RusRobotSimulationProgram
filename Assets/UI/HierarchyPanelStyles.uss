/* HierarchyPanelStyles.uss */

.unity-scroll-view__horizontal-scroller #unity-tracker {
    height: 16px;
    padding: 0;
    margin: 0;
    background-color: #34495e;
    border-color: #2c3e50;
}
.unity-scroll-view__vertical-scroller #unity-tracker {
    width: 16px;
    padding: 0;
    margin: 0;
    background-color: #34495e;
    border-color: #2c3e50;
}

#unity-dragger-button {
     padding: 0;
     margin: 0;
     height: 16px;
     border-color: #2c3e50;
}


#unity-low-button, #unity-high-button {
    height: 16px;
    width: 16px;
    padding: 0;
    margin: 0;
    background-color: #4a6486;
    color: #FFFFFF;
     border-color: #2c3e50;
}
.unity-scroll-view__horizontal-scroller #unity-slider {
    padding: 0;
    margin: 0 16px;
}
.unity-scroll-view__vertical-scroller #unity-slider {
    padding: 0;
    margin: 16px 0;
    max-width: 16px;
}
/* Для вертикального Scroller - ширина */
.unity-scroll-view__vertical-scroller {
    max-width: 16px !important;
    width: 16px !important;
    min-width: 16px !important;
    background-color: #2c3e50 !important;
}

/* Для горизонтального Scroller - высота */
.unity-scroll-view__horizontal-scroller {
    max-height: 16px !important;
    height: 16px !important;
    min-height: 16px !important;
    background-color: #2c3e50 !important;
}

/* Или общие стили для обоих Scroller */
.unity-scroll-view__vertical-scroller,
.unity-scroll-view__horizontal-scroller {
    background-color: #2c3e50 !important;
    border: 1px solid #1a252f !important;
}

/* Конкретно для вертикального */
.unity-scroll-view__vertical-scroller {
    width: 16px !important;
    min-width: 16px !important;
    max-width: 16px !important;
}

/* Конкретно для горизонтального */
.unity-scroll-view__horizontal-scroller {
    height: 16px !important;
    min-height: 16px !important;
    max-height: 16px !important;
}

.unity-scroll-view__vertical-scroller .unity-base-slider__input {
    max-width: 16px;
}

.unity-scroll-view__horizontal-scroller #unity-dragger {
    background-color: #4a6486;
    height: 14px;
    margin-top: -2px;
}
.unity-scroll-view__vertical-scroller #unity-dragger {
    background-color: #4a6486;
    width: 14px;
    margin-left: -2px;
}
#unity-dragger:hover {
    background-color: #5d7ca6 !important;
}

/* Основной контейнер панели */
.hierarchy-container {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    min-width: 0;
}

/* ScrollView - должен заполнять весь контейнер */
.hierarchy-scrollview {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
}

/* Контейнер контента ScrollView - должен расширяться */
.unity-scroll-view__content-container {
    min-width: 240px;
    width: auto;
    flex-shrink: 0;
    padding-bottom: 12px !important;
}

/* Основной Foldout */
#main-item {
    min-width: 240px;
    width: auto; /* Может быть шире */
    flex-shrink: 0;
}

/* Элементы иерархии - должны быть шире чем панель для появления прокрутки */
.hierarchy-item-robot,
.hierarchy-item-program,
.hierarchy-item-command {
    min-width: 300px; /* Сделай ШИРЕ чем 240px для теста! */
    width: auto;
    flex-shrink: 0;
    white-space: nowrap;
}


Label.selected {
    background-color: #2a6cff;
    border-radius: 3px;
}

    .custom-foldout .header.selected {
    background-color: #2a6cff !important;
    border-radius: 3px;
}

    #menu {
    padding-bottom: 20px;
        padding-left: 10px;
        padding-top: 10px;
}

#close-hierarhy-button {
    width: 20px;
    height: 20px;
    background-color: #ff4d4d;
    color: white;
    border-radius: 3px;
    border-width: 0;
    padding: 0;
    margin: 0;
      font-size: 10px;
}

#close-hierarhy-button:hover {
    background-color: #ff1a1a;
}