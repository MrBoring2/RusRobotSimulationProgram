.main-container {
    flex-direction: column;
    flex-grow: 1;
    position: relative;
}

/* Верхнее меню */
.menu-bar-container {
    height: 3%;
    background-color: #2c3e50;
}

/* Контент между меню и нижней панелью */
.content-container {
    flex-direction: row;
    flex-grow: 1;  /* занимает всё доступное пространство под меню */
    position: relative;
}


/* Центральная панель */
.center-panel {
    flex-grow: 1;
}

/* Нижняя панель */
.bottom-panel {
      /* чтобы фиксироваться внизу content-container */
    bottom: 0;
    top: 0;
    margin-bottom: 2%;
    margin-left: 3%;
               /* сдвиг на ширину левой панели */
    min-height: 12%;       /* высота панели в процентах */
    border-top: 1px solid #1a1a1a;
}

/* Правая панель */
.right-panel {
    width: 20%;
    background-color: #34495e;
    border-left: 1px solid #2c3e50;
    padding: 10px;
}
.left-panel {
    width: 240px;
    min-width: 240px;
    max-width: 240px;
    flex-shrink: 0;
    height: 100%;
    background-color: #34495e;
    border-right: 1px solid #2c3e50;
    /* overflow: hidden; - УБЕРИ ЭТУ СТРОКУ! */
}

.content-container {
    flex-grow: 1;
    display: flex;
    flex-direction: row;
    min-height: 0;
    min-width: 0;
    overflow: hidden;
}