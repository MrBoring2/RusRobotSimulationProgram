.main-container {
    flex-direction: column;
    flex-grow: 1;
    position: relative;
}

/* Верхнее меню */
.menu-bar-container {
    height: 3%;
    background-color: #2c3e50;
}

/* Контент между меню и нижней панелью */
.content-container {
    flex-direction: row;
    flex-grow: 1;  /* занимает всё доступное пространство под меню */
    position: relative;
}


/* Центральная панель */
.center-panel {
    flex-grow: 1;
}

/* Нижняя панель */
.bottom-panel {
      /* чтобы фиксироваться внизу content-container */
    bottom: 0;
    top: 0;
    margin-bottom: 2%;
    margin-left: 3%;
               /* сдвиг на ширину левой панели */
    min-height: 12%;       /* высота панели в процентах */
    border-top: 1px solid #1a1a1a;
}

/* Правая панель */
.right-panel {
    width: 20%;
    background-color: #34495e;
    border-left: 1px solid #2c3e50;
    padding: 10px;
}
.left-panel {
    width: 240px;
    min-width: 160px;
    max-width: 480px;
    flex-shrink: 0;
    height: 100%;
    background-color: #34495e;
    border-right: 1px solid #2c3e50;
    /* overflow: hidden; - УБЕРИ ЭТУ СТРОКУ! */
}
.resizer-vertical {
    width: 5px;
    flex-shrink: 0;
    cursor: col-resize;
    background-color: transparent;
    transition: background-color 0.2s;
}

.resizer-vertical:hover,
.resizer-vertical:active {
    background-color: #3498db;
}

.content-container {
    flex-grow: 1;
    display: flex;
    flex-direction: row;
    min-height: 0;
    min-width: 0;
    overflow: hidden;
}

.context-menu-hierarchy-container {
    background-color: #34495e;
    border-width: 1px;
    border-color: #13202e;
}

    .context-menu-hierarchy-container > Button {
        margin: 0;
        background-color: #9fbaff;
        font-size: 14px;
        unity-font-style: bold;
        -unity-font-style: bold;
        focusable: false;
        border-width: 1;
        border-color: #7f94cc;
        padding: 5px;
    }
    .context-menu-hierarchy-container > Button:hover {
        background-color: #d4dffa;
    }
  .drag-preview {
    position: absolute;
    background-color: rgba(66, 135, 245, 0.9);
    border: 2px solid #4287f5;
    border-radius: 4px;
    pointer-events: none;
    z-index: 9999;
    opacity: 0.9;
    box-shadow: 2px 2px 10px rgba(0,0,0,0.3);
    padding: 2px 8px;
    max-width: 200px;
}

.drag-preview > Label {
    color: white;
    font-size: 12px;
    font-weight: normal;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}