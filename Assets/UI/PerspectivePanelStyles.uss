.trapezoid-button {
    background-color: transparent;
    position: relative;

}
.middle-row {
    -unity-pointer-events: none;
}

/* “рапеции Ч реагируют на hover/click */
.trapezoid-button {
    -unity-pointer-events: auto;
}
.trapezoid-button:hover {
    
}
.perspective-panel-content-container {
    align-items: stretch;
    height: auto;
    flex-grow: 0;
    flex-shrink: 1;
    flex-direction: column;
    justify-content: flex-start;
    flex-wrap: nowrap;
    gap: 5px;
    padding: 0;
    margin: 0;
    width: 150px;
}
.trapezoid-wrapper {
    position: absolute;
    width: 15px;   /* Ўирина после поворота */
    height: 100px; /* ¬ысота после поворота */
}

.rotate-wrapper {
    width: 100px;
    height: 15px;
    position: relative;
}

.trapezoid-button-ch {
    background-color: transparent;
    position: absolute;
    width: 100%;
    height: 100%;
}
