.code-editor-window {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.8);
}

.code-editor-panel {
    position: absolute;
    width: 90%;
    height: 85%;
    left: 5%;
    top: 7%;
    background-color: rgb(30, 30, 35);
    border-width: 1px;
    border-color: rgb(60, 60, 70);
    border-radius: 8px;
    flex-direction: column;
}

.top-bar {
    height: 50px;
    background-color: rgb(40, 40, 45);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    flex-direction: row;
    padding-left: 10px;
    padding-right: 10px;
    align-items: center;
}

.dropdown-files {
    width: 200px;
    height: 32px;
    margin-right: 10px;
    font-size: 14px;
}

.unity-base-popup-field__input {
    padding-top: 6px;
    padding-right: 6px;
    padding-bottom: 6px;
    padding-left: 6px;
}

.toolbar-button {
    width: 36px;
    height: 36px;
    margin-left: 5px;
    margin-right: 5px;
    background-color: rgb(188, 188, 188);
    border-width: 1px;
    border-color: rgb(70, 70, 80);
    border-radius: 4px;
}

.toolbar-button:hover {
    background-color: rgb(60, 60, 65);
}

.toolbar-button:active {
    background-color: rgb(70, 70, 75);
}

.center-area {
    flex-grow: 1;
    margin: 10px;
    background-color: rgb(30, 30, 38);
    border-width: 1px;
    border-color: rgb(50, 50, 60);
    border-radius: 4px;
}

.bottom-bar {
    height: 45px;
    background-color: rgb(35, 35, 40);
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-left: 15px;
    padding-right: 15px;
}

.compilation-status {
    font-size: 12px;
    color: rgb(180, 180, 190);
}

.cursor-position {
    font-size: 12px;
    color: rgb(150, 150, 160);
}

.error-status {
    color: rgb(220, 80, 80);
}

.success-status {
    color: rgb(80, 200, 80);
}

#unity-text-input {
    background-color: rgba(0, 0, 0, 0);
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}


/*ScrollView TAKEN FROM HIERARCHY PANEL*/
#unity-dragger-button {
     padding: 0;
     margin: 0;
     height: 16px;
     border-color: #2c3e50;
}
#unity-low-button, #unity-high-button {
    height: 16px;
    width: 16px;
    padding: 0;
    margin: 0;
    background-color: #4a6486;
    color: #FFFFFF;
     border-color: #2c3e50;
}
.unity-scroll-view__horizontal-scroller #unity-tracker {
    height: 16px;
    padding: 0;
    margin: 0;
    background-color: #34495e;
    border-color: #2c3e50;
}
.unity-scroll-view__vertical-scroller #unity-tracker {
    width: 16px;
    padding: 0;
    margin: 0;
    background-color: #34495e;
    border-color: #2c3e50;
}
.unity-scroll-view__horizontal-scroller #unity-slider {
    padding: 0;
    margin: 0 16px;
}
.unity-scroll-view__vertical-scroller #unity-slider {
    padding: 0;
    margin: 16px 0;
    max-width: 16px;
}
/* Для вертикального Scroller */
.unity-scroll-view__vertical-scroller {
    max-width: 16px !important;
    width: 16px !important;
    min-width: 16px !important;
    background-color: #2c3e50 !important;
    border: 1px solid #1a252f !important;
}
/* Для горизонтального Scroller */
.unity-scroll-view__horizontal-scroller {
    max-height: 16px !important;
    height: 16px !important;
    min-height: 16px !important;
    background-color: #2c3e50 !important;
    border: 1px solid #1a252f !important;
}
.unity-scroll-view__vertical-scroller .unity-base-slider__input {
    max-width: 16px;
}
.unity-scroll-view__horizontal-scroller #unity-dragger {
    background-color: #4a6486;
    height: 14px;
    margin-top: -2px;
}
.unity-scroll-view__vertical-scroller #unity-dragger {
    background-color: #4a6486;
    width: 14px;
    margin-left: -1.4px;
}
#unity-dragger:hover {
    background-color: #5d7ca6 !important;
}
