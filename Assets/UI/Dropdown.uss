.unity-base-dropdown .unity-base-dropdown__container-outer {
    background-color: rgb(30, 40, 60);
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-color: rgb(60, 80, 120);
    border-bottom-color: rgb(60, 80, 120);
    border-left-color: rgb(60, 80, 120);
    border-right-color: rgb(60, 80, 120);
}

.unity-base-dropdown .unity-scroll-view {
    background-color: rgb(30, 40, 60);
}

.unity-base-dropdown .unity-scroll-view__content-and-vertical-scroll-container {
    background-color: rgb(30, 40, 60);
}

.unity-base-dropdown .unity-base-dropdown__item {
    background-color: rgb(30, 40, 60);
    color: rgb(255, 255, 255);
    font-size: 13px;
    height: 24px;
    padding-left: 8px;
    padding-right: 8px;
    -unity-text-align: middle-left;
}

.unity-base-dropdown .unity-base-dropdown__item:hover {
    background-color: rgb(50, 70, 110);
}

.unity-base-dropdown .unity-base-dropdown__item:selected {
    background-color: rgb(60, 80, 140);
}