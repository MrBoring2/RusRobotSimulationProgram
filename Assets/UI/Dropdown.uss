/* ===== Основной контейнер выпадающего списка ===== */
.unity-base-dropdown .unity-base-dropdown__container-outer {
    background-color: rgb(30, 40, 60);
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-color: rgb(60, 80, 120);
    border-bottom-color: rgb(60, 80, 120);
    border-left-color: rgb(60, 80, 120);
    border-right-color: rgb(60, 80, 120);
}

/* ===== Скролл выпадающего списка ===== */
.unity-base-dropdown .unity-scroll-view {
    background-color: rgb(30, 40, 60);
}
.unity-base-dropdown .unity-scroll-view__content-and-vertical-scroll-container {
    background-color: rgb(30, 40, 60);
}

/* ===== Элементы выпадающего списка ===== */
.unity-base-dropdown .unity-base-dropdown__item {
    background-color: rgb(30, 40, 60);
    color: rgb(255, 255, 255);
    font-size: 13px;
    height: 24px;
    padding-left: 8px;
    padding-right: 8px;
    -unity-text-align: middle-left;
}

.unity-base-dropdown .unity-base-dropdown__item:hover {
    background-color: rgb(50, 70, 110);
}

.unity-base-dropdown .unity-base-dropdown__item:selected {
    background-color: rgb(60, 80, 140);
}

/* ===== Кастомный дропдаун ===== */
.custom-dropdown {
    margin-left: 0px;
    margin-right: 0px;
}
/* Текст внутри поля ввода - отступ слева */
.custom-dropdown .unity-base-popup-field__text {
    color: rgb(255, 255, 255);
    font-size: 13px;
    -unity-text-align: middle-left;
    flex-grow: 1;
    margin-left: 8px;
}

/* Стрелка - отступ справа */
.custom-dropdown .unity-base-popup-field__arrow {
    -unity-background-image-tint-color: rgb(180, 200, 240);
    -unity-text-align: middle-center;
    margin-right: 4px;
}

/* ВНУТРЕННИЙ КОНТЕЙНЕР ПОЛЯ ВВОДА - где текст */
.custom-dropdown .unity-base-popup-field__input .unity-base-field__input__container,
.custom-dropdown .unity-base-field__input__container,
.custom-dropdown .unity-base-popup-field__input .unity-base-popup-field__input__container {
    padding-left: 5px;
    padding-right: 5px;
}

/* Базовое состояние */
VisualElement.unity-base-popup-field.unity-base-popup-field__input,
VisualElement.unity-base-popup-field .unity-base-popup-field__input,
.custom-dropdown.unity-base-popup-field .unity-base-popup-field__input,
.custom-dropdown VisualElement.unity-base-popup-field__input {
    background-color: rgb(30, 40, 60);
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-color: rgb(60, 80, 120);
    border-bottom-color: rgb(60, 80, 120);
    border-left-color: rgb(60, 80, 120);
    border-right-color: rgb(60, 80, 120);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    height: 24px;
    flex-direction: row;
    align-items: center;
    padding-left: 5px;
    padding-right: 5px;
}

/* HOVER */
.custom-dropdown.unity-base-popup-field:hover VisualElement.unity-base-popup-field__input,
.custom-dropdown:hover VisualElement.unity-base-popup-field__input,
VisualElement.custom-dropdown:hover .unity-base-popup-field__input,
VisualElement.unity-base-popup-field.custom-dropdown:hover .unity-base-popup-field__input,
.unity-base-popup-field.custom-dropdown:hover .unity-base-popup-field__input {
    background-color: rgb(35, 48, 70);
    border-top-color: rgb(80, 100, 160);
    border-bottom-color: rgb(80, 100, 160);
    border-left-color: rgb(80, 100, 160);
    border-right-color: rgb(80, 100, 160);
}

/* ACTIVE */
.custom-dropdown.unity-base-popup-field:active VisualElement.unity-base-popup-field__input,
.custom-dropdown:active VisualElement.unity-base-popup-field__input,
VisualElement.custom-dropdown:active .unity-base-popup-field__input,
VisualElement.unity-base-popup-field.custom-dropdown:active .unity-base-popup-field__input,
.unity-base-popup-field.custom-dropdown:active .unity-base-popup-field__input {
    background-color: rgb(35, 48, 70);
    border-top-color: rgb(80, 100, 160);
    border-bottom-color: rgb(80, 100, 160);
    border-left-color: rgb(80, 100, 160);
    border-right-color: rgb(80, 100, 160);
}

/* FOCUS */
.custom-dropdown.unity-base-popup-field:focus VisualElement.unity-base-popup-field__input,
.custom-dropdown:focus VisualElement.unity-base-popup-field__input,
VisualElement.custom-dropdown:focus .unity-base-popup-field__input,
VisualElement.unity-base-popup-field.custom-dropdown:focus .unity-base-popup-field__input,
.unity-base-popup-field.custom-dropdown:focus .unity-base-popup-field__input {
    background-color: rgb(35, 48, 70);
    border-top-color: rgb(80, 100, 160);
    border-bottom-color: rgb(80, 100, 160);
    border-left-color: rgb(80, 100, 160);
    border-right-color: rgb(80, 100, 160);
}

/* OPEN */
.custom-dropdown.unity-base-popup-field--open VisualElement.unity-base-popup-field__input,
.custom-dropdown.unity-base-popup-field--open:hover VisualElement.unity-base-popup-field__input,
VisualElement.custom-dropdown.unity-base-popup-field--open .unity-base-popup-field__input,
.unity-base-popup-field--open.custom-dropdown .unity-base-popup-field__input {
    background-color: rgb(35, 48, 70);
    border-top-color: rgb(80, 100, 160);
    border-bottom-color: rgb(80, 100, 160);
    border-left-color: rgb(80, 100, 160);
    border-right-color: rgb(80, 100, 160);
}

/* OPEN + ACTIVE */
.custom-dropdown.unity-base-popup-field--open:active VisualElement.unity-base-popup-field__input,
.unity-base-popup-field--open.custom-dropdown:active .unity-base-popup-field__input {
    background-color: rgb(35, 48, 70);
    border-top-color: rgb(80, 100, 160);
    border-bottom-color: rgb(80, 100, 160);
    border-left-color: rgb(80, 100, 160);
    border-right-color: rgb(80, 100, 160);
}

/* Текст в поле ввода */
.custom-dropdown .unity-base-popup-field__text {
    color: rgb(255, 255, 255);
    font-size: 13px;
    -unity-text-align: middle-left;
    flex-grow: 1;
}

/* Стрелка дропдауна */
.custom-dropdown .unity-base-popup-field__arrow {
    -unity-background-image-tint-color: rgb(180, 200, 240);
    -unity-text-align: middle-center;
}

.unity-base-dropdown .unity-scroll-view .unity-scroll-view__content-and-vertical-scroll-container .unity-scroll-view__vertical-scroller {
    display: none;
}

.unity-base-dropdown .unity-scroll-view__content-container {
    overflow: hidden;
}