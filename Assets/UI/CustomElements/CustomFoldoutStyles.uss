.custom-foldout {
    /*border-radius: 4px;
    border-left-width: 1px; */
    border-left-color: #2779c6;
    border-bottom-color: #2779c6;
    margin-top: 2px;
    min-width: 220px;
}

/* Заголовок */
.custom-foldout .header {
    background-color: #2779c6;
    color: #FFFFFF;
    border-radius: 3px;
    display: flex;
    align-items: center;
    height: 15px;
    min-height: 15px;
    max-height: 15px;
    padding: 0 5px;
}

/* Кнопка раскрытия */
.custom-foldout .header .toggle-button {
    width: 12px; 
    height: 12px;
    min-width: 12px;
    min-height: 12px;
    max-width: 12px;
    max-height: 12px;
    background-color: transparent;
    border-radius: 0px;
    border-width: 0px;
    justify-content: center;
    align-items: center;
    display: flex;
    margin-right: 5px;

    padding: 0;
    padding-bottom: 1px;
    
    
    font-size: 14px;
}

 .header .toggle-button {
  
 }

/* Метка */
.custom-foldout .header .unity-label {
    height: 100%;
    align-items: center;
    display: flex;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    flex-grow: 1;
    font-size: 12px;
    padding: 0px;
    padding-top: 1px;
    margin: 0px;
}

/* Контент */
.custom-foldout .content {
    margin-top: 2px;
    padding-left: 15px; 
    border-radius: 3px;
    display: none; 
    flex-direction: column; 
    flex-shrink: 0;
}

/* Показываем контент при раскрытии */
.custom-foldout.expanded .content {
    display: flex;
}

/* Отступ для вложенных foldout */
.custom-foldout .content .custom-foldout {
   
}
